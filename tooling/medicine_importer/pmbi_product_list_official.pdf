    <div class="container whitebg">
        <div class="row">
            <div class="col-md-12">
                <h1>Find Product details</h1>
                <img src="images/line.jpg" alt="" class="img-responsive"/>
            </div>
        </div>
    </div>
    <div class="container whitebg pb20">
        <div class="row">
            <div class="col-md-9">
                <div class="row">
                    
                    <div class="col-md-3" style="display:none">
                        <div class="form-group"><label for="First Name">Select Product Department :</label>
                            <select name="ctl00$Bppi_body$ddlProduct" onchange="javascript:setTimeout(&#39;__doPostBack(\&#39;ctl00$Bppi_body$ddlProduct\&#39;,\&#39;\&#39;)&#39;, 0)" id="Bppi_body_ddlProduct" class="form-control">

</select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group"><label for="First Name">Search by Drug Code/Product Name/Unit Size/MRP :</label>
                            <div class="form-group"><input name="ctl00$Bppi_body$txtSearch" type="text" maxlength="10" id="Bppi_body_txtSearch" onkeypress="return /[0-9a-zA-Z]/i.test(event.key)" placeholder="Enter Drug Code/Product Name" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <br />
                    <div id="Bppi_body_divSearch">
                        <input type="submit" name="ctl00$Bppi_body$btnSearch" value="Search" id="Bppi_body_btnSearch" class="form-control" style="color:#FAFAFA;background-color:#245B49;border-color:#245B49;height:40px;width:20%;" />
                    </div>
                </div>
                <span style="font-style:oblique; font-weight:700; color:red"> <b>**</b>Note:- Zero MRP products are under process</span>
                <div class="row">
                    <div class="col-md-9">
                        <div class="img-responsive">
                            
                        </div>
                        
                    </div>
                </div>
                
            </div>
